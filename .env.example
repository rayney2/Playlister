# Copy to .dev.vars (Workers) or .env (local) and fill in. Never commit the real file.
# All of these are optional; the pipeline runs with none of them set.

# Free, requires registration: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Free, requires registration: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Only needed if the story step falls back to a backend LLM
# rather than Apple Intelligence on-device.
ANTHROPIC_API_KEY=
