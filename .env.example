# Copy to .env (local) or .dev.vars (Workers dev). Never commit the real file.
# See ACCESS.md for step-by-step instructions for each one.
#
# ALL OF THESE ARE OPTIONAL. The pipeline runs fully with none of them set:
# KEXP, BBC, ABC, SomaFM, Deezer, iTunes, Wikipedia, ListenBrainz, MusicBrainz
# and the editorial RSS feeds all need no credentials.

# Free, instant: https://www.last.fm/api/account/create
# Unlocks tag.getTopTracks for genre-tagged tracks at volume.
LASTFM_API_KEY=

# Free app registration: https://developer.spotify.com/dashboard
# Largest playlist ecosystem available. Client Credentials flow, no user login.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Free: https://www.discogs.com/settings/developers
# Only needed to lift the ~25/min unauthenticated rate limit.
DISCOGS_TOKEN=

# Only if the story step falls back to a backend LLM instead of
# Apple Intelligence on-device.
ANTHROPIC_API_KEY=
