{
  "name": "playlister",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "On-demand human-curated music discovery: curated sources -> dedupe -> Apple Music resolution -> grounded listening guide.",
  "scripts": {
    "discover": "node --experimental-strip-types src/cli.ts",
    "discover:niche": "node --experimental-strip-types src/cli.ts --popular 0.1 --mid 0.3 --niche 0.6",
    "discover:wide": "node --experimental-strip-types src/cli.ts --tracks 25 --max-source-share 0.15",
    "probe:feeds": "node --experimental-strip-types src/cli.ts --probe-feeds",
    "test": "node --experimental-strip-types --test",
    "test:watch": "node --experimental-strip-types --test --watch",
    "verify:keys": "node --env-file=.env --experimental-strip-types src/verify-keys.ts",
    "harvest": "node --env-file=.env --experimental-strip-types src/cli-harvest.ts",
    "chain": "node --env-file=.env --experimental-strip-types src/cli-chain.ts"
  }
}
